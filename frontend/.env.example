# Frontend build/runtime settings. The browser only ever calls /api on this site; Next forwards it to the Python app.
# API_ORIGIN is read when `npm run build` runs (it is baked into the rewrite), so set it before building.
API_ORIGIN=https://your-domain.example      # cPanel: the same domain, /api is routed to the Python app (see docs/CPANEL_DEPLOY.md)
# API_ORIGIN=http://api:8000                # docker compose
PORT=3000
