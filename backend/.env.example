# FlatWise API settings. Copy to .env (chmod 600) or set the same names in cPanel > Setup Python App.
# NEVER commit the real file. Values below are examples only.
ENV=production

# Required in production (the app refuses to start without them):
SECRET_KEY=            # random, 32+ chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
NID_KEY=               # Fernet key:         python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=mysql://flatwise_user:PASSWORD@localhost/cpuser_flatwise     # or postgresql://user:pass@host:5432/flatwise
APP_URL=https://app.example.com   # public https address of the web app (links in emails)

# Must stay off in production:
DEMO=0

# Optional
UPLOAD_DIR=/home/cpuser/flatwise-data/uploads    # outside the web root, backed up with the database
CORS_ORIGINS=                                    # empty = same-origin only; never '*'
LOG_LEVEL=INFO
LOG_FORMAT=json
TOKEN_HOURS=24
DB_POOL_SIZE=3          # shared hosting allows few MySQL connections
DB_MAX_OVERFLOW=2
WEB_CONCURRENCY=2       # docker/uvicorn only
MAIL_PROVIDER=sandbox   # see backend/app/services/mailer.py for real providers

# First SUPER_ADMIN, read once by `python -m app.bootstrap`
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=   # 12+ chars; remove from the environment after the first run
